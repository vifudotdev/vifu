# Essential defaults for Docker Compose self-hosting.
# For a default deployment:
#   cp .env.example .env
#   docker compose up -d

VIFU_DEPLOYMENT_MODE=self-hosted

# Leave these blank to generate independent values into the Docker
# `vifu_secrets` volume on first startup. Set explicit values only when
# restoring or rotating an existing deployment.
VIFU_ADMIN_KEY=
VIFU_AGENT_GATEWAY_BOOTSTRAP_TOKEN=
VIFU_API_KEY_PEPPER=
VIFU_PROVIDER_SECRET_KEY=
VIFU_PGADMIN_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=

VIFU_BIND_HOST=127.0.0.1
POSTGRES_BIND_HOST=127.0.0.1
NEXT_PUBLIC_VIFU_API_BASE_URL=http://localhost:6790
POSTGRES_DB=vifu
POSTGRES_USER=vifu
POSTGRES_PORT=5432
VIFU_SERVER_PORT=6790
VIFU_DASHBOARD_PORT=6791

# New gateways receive a temporary project until an owner claims it.
VIFU_GUEST_BOOTSTRAP_ENABLED=true
VIFU_GUEST_BOOTSTRAP_TTL_HOURS=168
VIFU_GUEST_BOOTSTRAP_MAX_PROJECTS=10000

# Optional local-only PostgreSQL browser:
#   docker compose --profile database-tools up -d pgadmin
VIFU_PGADMIN_EMAIL=pgadmin@vifu.dev
VIFU_PGADMIN_BIND_HOST=127.0.0.1
VIFU_PGADMIN_PORT=5050
