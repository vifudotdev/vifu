# Copy this file to .env.local for local Docker testing.
# Do not commit .env.local or any file containing real credentials.

# Local relay listener.
VIFU_LISTEN_ADDR=0.0.0.0:48989

# Optional Vifu Cloud control plane registration.
# Keep disabled for local/self-host relay tests that do not need cloud account auth.
VIFU_CLOUD_ENABLED=0
VIFU_API_BASE_URL=https://api.example.test
VIFU_SERVICE_ID=vifu-relay-dev
VIFU_SERVICE_USERNAME=service@example.test
VIFU_SERVICE_PASSWORD=replace-me
VIFU_RELAY_ID=local-relay
VIFU_RELAY_ENDPOINT=tcp://127.0.0.1:48989
VIFU_RELAY_REGION=local
VIFU_RELAY_CAPACITY=32
VIFU_HEARTBEAT_INTERVAL_SECONDS=30
VIFU_REQUEST_TIMEOUT_SECONDS=10
