# Loopback source-development defaults. Self-hosted Docker users should run
# `sh scripts/init-self-hosted.sh` to create independent random secrets.
VIFU_DEPLOYMENT_MODE=local
# Dashboard authentication. Loopback source development defaults to no login;
# `scripts/init-self-hosted.sh` enables email/password signup for self-hosting.
VIFU_AUTH_MODE=none
VIFU_AUTH_PASSWORD_ENABLED=false
VIFU_SIGNUP_ENABLED=false
AUTH_DISABLE_USERNAME_PASSWORD=true
AUTH_DISABLE_SIGNUP=true
VIFU_SERVER_ADDR=127.0.0.1:6790
DATABASE_URL=postgres://vifu@127.0.0.1:5432/vifu
VIFU_ADMIN_KEY=replace-with-at-least-16-characters
VIFU_AGENT_GATEWAY_TOKEN=replace-with-a-different-16-character-value
VIFU_API_KEY_PEPPER=replace-with-another-16-character-value
VIFU_PROJECT_DOMAIN=localhost

# Dashboard server and browser endpoints
VIFU_API_BASE_URL=http://127.0.0.1:6790
NEXT_PUBLIC_VIFU_API_BASE_URL=http://localhost:6790
NEXT_PUBLIC_VIFU_PROJECT_DOMAIN=localhost

# Agent Gateway
VIFU_SERVER_URL=http://127.0.0.1:6790
VIFU_OPENCLAW_URL=http://127.0.0.1:18789
VIFU_OPENCLAW_TOKEN=

# Docker Compose defaults
VIFU_BIND_HOST=127.0.0.1
POSTGRES_DB=vifu
POSTGRES_USER=vifu
POSTGRES_PASSWORD=vifu
POSTGRES_PORT=5432
VIFU_SERVER_PORT=6790
VIFU_DASHBOARD_PORT=6791

# Optional self-hosted OIDC provider. Configure all required values together.
AUTH_ENABLE_OIDC=false
AUTH_CUSTOM_ISSUER=
AUTH_CUSTOM_CLIENT_ID=
AUTH_CUSTOM_CLIENT_SECRET=
AUTH_CUSTOM_NAME=Single sign-on
VIFU_AUTH_OIDC_ISSUER=
VIFU_AUTH_OIDC_CLIENT_ID=
VIFU_AUTH_OIDC_CLIENT_SECRET=
VIFU_AUTH_OIDC_REDIRECT_URL=http://localhost:6791/api/auth/oidc/oidc/callback
VIFU_AUTH_OIDC_NAME=Single sign-on
VIFU_AUTH_OIDC_SCOPES=openid profile email
VIFU_AUTH_OIDC_BOOTSTRAP_EMAIL=
