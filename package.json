{
  "name": "vifu",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "npm-packages/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:boundaries && bun run check:public && bun run typecheck",
    "check:boundaries": "node scripts/check-dashboard-boundaries.mjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "typecheck": "bun run --cwd npm-packages/dashboard typecheck",
    "build": "bun run --cwd npm-packages/dashboard build",
    "test:e2e": "playwright test",
    "test:oidc": "sh scripts/run-oidc-e2e.sh",
    "test:self-hosted": "sh scripts/run-self-hosted-e2e.sh",
    "dev:database": "docker compose --env-file .env.local -f self-hosted/docker/docker-compose.yml -f self-hosted/docker/docker-compose.local.yml up -d postgres",
    "dev:database:down": "docker compose --env-file .env.local -f self-hosted/docker/docker-compose.yml -f self-hosted/docker/docker-compose.local.yml down",
    "dev:server": "sh scripts/dev-server.sh",
    "dev:agent-gateway": "sh scripts/dev-agent-gateway.sh",
    "dev:openclaw-mock": "node scripts/mock-openclaw.mjs",
    "dev:dashboard": "sh scripts/dev-dashboard.sh",
    "dev:local": "sh scripts/local.sh",
    "local": "sh scripts/local.sh",
    "local:stop": "sh scripts/local-stop.sh",
    "local:restart": "sh scripts/local-stop.sh && sh scripts/local.sh",
    "self-host": "sh scripts/self-host.sh",
    "self-host:stop": "docker compose stop",
    "self-host:restart": "docker compose restart",
    "self-host:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vitest": "^3.2.4"
  }
}
