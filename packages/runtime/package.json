{
  "name": "@vifu/runtime",
  "version": "0.1.0",
  "description": "Browser-safe Vifu game runtime host utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudEventBus": {
      "types": "./dist/cloudEventBus.d.ts",
      "import": "./dist/cloudEventBus.js"
    },
    "./runtimeIframeViewport": {
      "types": "./dist/runtimeIframeViewport.d.ts",
      "import": "./dist/runtimeIframeViewport.js"
    },
    "./runtimeSandbox": {
      "types": "./dist/runtimeSandbox.d.ts",
      "import": "./dist/runtimeSandbox.js"
    },
    "./runtimeHost": {
      "types": "./dist/runtimeHost.d.ts",
      "import": "./dist/runtimeHost.js"
    },
    "./runtimeUrl": {
      "types": "./dist/runtimeUrl.d.ts",
      "import": "./dist/runtimeUrl.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
