{
  "name": "@vifu/sdk",
  "version": "0.1.0-alpha.9",
  "description": "Vifu browser bridge SDK for iframe and WKWebView game runtimes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/browser/vifu-sdk.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/browser/vifu-sdk.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "bun run build && vitest run",
    "test:ci": "bun run build && vitest run",
    "typecheck": "bun run build && tsc --noEmit --strict --target ES2020 --module NodeNext --moduleResolution NodeNext --lib ES2020,DOM test/types.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "vitest": "^3.2.4",
    "typescript": "^5.7.0"
  }
}
