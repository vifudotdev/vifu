{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@vifu/runtime": ["./packages/runtime/src/index.ts"],
      "@vifu/runtime/*": ["./packages/runtime/src/*.ts"],
      "@vifu/sdk": ["./packages/sdk/src/index.d.ts"]
    }
  }
}
