# Essential defaults for Docker Compose self-hosting.
# For a default deployment:
#   cp .env.example .env
#   docker compose up -d

VIFU_DEPLOYMENT_MODE=self-hosted
VIFU_AUTH_MODE=local-password
VIFU_AUTH_PASSWORD_ENABLED=true
VIFU_SIGNUP_ENABLED=true
AUTH_DISABLE_USERNAME_PASSWORD=false
AUTH_DISABLE_SIGNUP=false

# Leave these blank to generate independent values into the Docker
# `vifu_secrets` volume on first startup. Set explicit values only when
# restoring or rotating an existing deployment.
VIFU_ADMIN_KEY=
VIFU_AGENT_GATEWAY_TOKEN=
VIFU_API_KEY_PEPPER=
VIFU_PROVIDER_SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=

VIFU_BIND_HOST=127.0.0.1
POSTGRES_DB=vifu
POSTGRES_USER=vifu
POSTGRES_PORT=5432
VIFU_SERVER_PORT=6790
VIFU_DASHBOARD_PORT=6791

# Host-side Vifu configuration. The Compose stack mounts this at
# /home/vifu/.vifu inside the backend and Agent Gateway containers.
# Leave blank to use ~/.vifu.
VIFU_CONFIG_DIR=

AUTH_ENABLE_OIDC=false
VIFU_AUTH_OIDC_ISSUER=
VIFU_AUTH_OIDC_CLIENT_ID=
VIFU_AUTH_OIDC_CLIENT_SECRET=
VIFU_AUTH_OIDC_REDIRECT_URL=
VIFU_AUTH_OIDC_NAME=
VIFU_AUTH_OIDC_SCOPES=openid profile email
VIFU_AUTH_OIDC_BOOTSTRAP_EMAIL=
